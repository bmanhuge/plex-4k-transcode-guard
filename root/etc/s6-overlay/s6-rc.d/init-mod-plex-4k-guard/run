#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# One-shot init for the plex-4k-transcode-guard Docker Mod. It only reports
# what is installed; it never fails, because a failing init-mod-* oneshot
# would keep every later service (including Plex itself) from starting. The
# effective mode is stated by the guard's own "effective mode" log line.

BIN="/usr/local/bin/plex-4k-guard"

if [[ ! -x "${BIN}" ]]; then
    echo "[mod-init] plex-4k-guard: binary missing at ${BIN}; the guard service will not start"
    exit 0
fi

echo "[mod-init] $("${BIN}" --version 2>/dev/null || echo "plex-4k-guard unknown") installed; see the [plex-4k-guard] log lines for the effective mode"
exit 0
